# Vivado Project gitignore template
# Ignore local folders generated by Vivado
**/*.cache/
**/*.hw/
**/*.ip_user_files/
**/*.sim/
**/*.xsim.dir/
**/.Xil/

# Ignore log and journal files
*.log
*.jou
*.pb
*.backup.jou
*.backup.log
*.wdb
dfx_runtime.txt

# OS-specific files
Thumbs.db
.DS_Store
desktop.ini
.vscode/
